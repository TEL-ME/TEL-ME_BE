# 사용법: 이 파일을 복사해 .env 로 만들고 필요한 값만 바꾼다
#   cp .env.example .env
# .env 는 커밋하지 않는다

# PostgreSQL (docker-compose · application.yml 공통)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telme
POSTGRES_USER=telme
POSTGRES_PASSWORD=telme

# Ollama (Docker · Mac 앱 모두 기본 주소 동일)
OLLAMA_PORT=11434
OLLAMA_URL=http://localhost:11434

# LLM 구현체 선택 (fake / ollama). bootRun·STS는 실행 환경변수에 따로 설정
LLM_PROVIDER=fake
LLM_MODEL=exaone3.5:7.8b

# 모델이 한 번에 읽는 토큰 수. 8192는 EXAONE 기준 약 6GB를 쓴다. 메모리가 부족하면 4096으로 낮춘다
LLM_CONTEXT_SIZE=8192

# 임베딩 콜드 로드 방지 워밍업. 로컬/테스트는 꺼두고, 실제 배포 환경에서만 true로 켠다.
EMBEDDING_WARMUP_ENABLED=false

# 검색 결과 채택 최소 유사도. 잠정값(2주차 임계값 캘리브레이션 전까지).
SEARCH_SIMILARITY_THRESHOLD=0.7

# 비회원 세션 유지 기간 (예: 30d, 12h). bootRun·STS는 실행 환경변수에 따로 설정
GUEST_TTL=30d

# 피드백 API와 대화 이력의 평가 상태 표시. bootRun과 STS는 실행 환경변수에 따로 설정
TELME_FEEDBACK_ENABLED=true

# 내부 검색 테스트 API 노출 여부. 로컬은 true, 운영은 prod 프로파일에서 강제로 false.
# bootRun·STS는 실행 환경변수에 따로 설정
FAQ_SEARCH_TEST_API_ENABLED=true

# 임베딩 텍스트 구성 (QUESTION_ONLY | Q_A | CATEGORY_Q_A | Q_A_HEAD200)
# 바꾸면 FAQ_REEMBED_ENABLED=true로 전량 재임베딩해야 검색에 반영된다
FAQ_EMBEDDING_TEXT_VARIANT=Q_A

# FAQ 전량 재임베딩
# true로 기동하면 faqs 전체를 현재 variant로 다시 임베딩하고 종료. 적재와 마찬가지로 단일 프로세스로만 실행
FAQ_REEMBED_ENABLED=false

# FAQ 배치 적재
# true로 기동하면 FAQ_BATCH_LOAD_PATH의 JSON을 faqs/faq_embeddings에 넣고 종료
# 적재 러너는 단일 프로세스로만 실행 (동시 실행 시 같은 FAQ가 중복 적재될 수 있음)
# 평소엔 false. 적재할 때만 bootRun --args 또는 환경변수로 켠다 (scripts/README.md "적재" 절)
FAQ_BATCH_LOAD_ENABLED=false
FAQ_BATCH_LOAD_PATH=scripts/data/faq_full_300.json

# 카카오 로그인 (developers.kakao.com 앱의 "앱 키 > REST API 키", "보안 > Client Secret")
# 빈 문자열로 두면 application.yml의 더미값 폴백이 안 먹는다(환경변수가 "없음"이 아니라 "빈 값"으로 잡혀서) —
# 실제 카카오 로그인이 필요 없으면 아래 더미값을 그대로 두고, 필요할 때만 진짜 키로 바꾼다
KAKAO_CLIENT_ID=dummy-client-id
KAKAO_CLIENT_SECRET=dummy-client-secret

# 카카오 로컬 API(지명·주소 → 좌표). 비워 두면 KAKAO_CLIENT_ID(같은 앱의 REST API 키)를 쓴다.
# 다른 앱 키를 쓸 때만 지정한다. 콘솔의 "카카오맵" 사용 설정이 켜져 있어야 호출된다
# KAKAO_REST_API_KEY=

# 챗봇 답변 듣기·음성 질문 인식(Amazon Polly, Transcribe). 팀 AWS 계정의 음성 전용 IAM 키를 넣는다. 비워 두면 음성 요청만 SPEECH503-0/503-1로 실패한다
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# 음성 질문 인식에 요금제명·통신 용어 단어집을 쓴다. 팀 AWS 계정(서울 리전)에 만든 이름이고, 비우면 단어집 없이 인식한다
# SPEECH_STT_VOCABULARY_NAME=telme-ko

# 검색 근거 판정(Amazon Bedrock, 회색 구간). 기본 켜짐이라 Bedrock API 키를 넣는다. 리전은 기본 us-east-1
# 위 음성용 AWS 키에는 Bedrock 권한이 없다. 이 키가 없으면 판정이 모두 실패한다
# AWS_BEARER_TOKEN_BEDROCK=
# 로컬에서 키 없이 쓰려면 회색 구간을 끈다(지금 동작과 같음). LLM_BEDROCK_ENABLED=false만 넣으면 앱이 뜨지 않는다
# SEARCH_GRAY_ZONE_ENABLED=false

# 구글 로그인 (Google Cloud Console > Google 인증 플랫폼 > 클라이언트)
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# 소셜 로그인 성공/실패 후 리다이렉트할 프론트엔드 URL
FRONTEND_URL=http://localhost:3000

# 상담 저장·되묻기·Chat/RAG 연결. 채팅 처리 구현(ConsultChatProcessingService)이 쓰므로 모두 true로 둔다.
# 하나라도 false면 채팅 요청이 처리되지 않는다
CONSULT_PERSISTENCE_ENABLED=true
CONSULT_LLM_ENABLED=true
CONSULT_CHAT_INTEGRATION_ENABLED=true
CONSULT_RAG_INTEGRATION_ENABLED=true
# 정상 답변 아래 추천 질문 버튼(docs/FOLLOWUP_RECOMMENDATION.md). 기본으로 켠다. bootRun·STS는 실행 환경변수에 따로 설정
CONSULT_SUGGESTED_QUESTIONS_ENABLED=true
# 위 추천 질문에 매장 찾기 버튼을 더한다. 추천 질문이 켜져 있을 때만 동작한다
CONSULT_SUGGESTED_QUESTIONS_STORE_CHIP_ENABLED=true
# 답을 못 할 때 "혹시 이런 내용을 찾으셨나요?" 버튼을 더한다. 추천 질문이 켜져 있을 때만 동작한다
CONSULT_SUGGESTED_QUESTIONS_NO_ANSWER_ENABLED=false

# 요금제 가입·변경 시연 모드. 켜면 즉시 적용되고 가입 당월·월 1회 변경 제한도 생략한다. 기본은 정책대로(false).
# bootRun·STS는 실행 환경변수에 따로 설정
TELME_SUBSCRIPTION_DEMO_MODE=false

# 라우팅 요청 개수 판정(docs/ROUTING_CALL_COMPARISON.md 2단계). EXAONE 의도 분류의 과잉 분해를 막는 장치라 지금은 켠다.
# 의도 분류를 gpt-oss(Bedrock)로 바꾸면 false로 끈다. 켜 두면 맞게 나뉜 질문을 다시 합친다
ROUTING_REQUEST_INVENTORY_ENABLED=true

# 라우팅 호출을 gpt-oss(Bedrock)로 부른다. 실패하면 엑사원으로 대체한다. 켜면 위 요청 개수 판정은 false로 끈다
ROUTING_BEDROCK=false

# 문맥 판정 흔들림 보완(docs/CONTEXT_RESOLUTION.md TELME-165 2차). gpt-oss가 업무 개수를 틀리거나 답이 잘리는 실패를 막는다.
# EXAONE에서는 결과가 같아 지금은 끈다. 아래 CHAT_QUESTION_RESOLUTION_BEDROCK을 켜면 이 값과 관계없이 켜진다
CHAT_QUESTION_RESOLUTION_STABILITY_GUARDS=false
# 문맥 판정을 gpt-oss(Bedrock)로 부른다. 실패하면 엑사원으로 대체한다. 켜면 위 흔들림 보완도 함께 켜진다
CHAT_QUESTION_RESOLUTION_BEDROCK=false

# 되묻기 조건 뽑기를 gpt-oss(Bedrock)로 쓴다. 실패하면 엑사원으로 대체한다. docs/CLARIFICATION_EXTRACTION_MODEL.md
CONSULT_FAQ_CLARIFICATION_BEDROCK=false

# 비교·FAQ 후보 근거 검증을 gpt-oss(Bedrock)로 쓴다. 실패하면 엑사원으로 대체한다. docs/EVIDENCE_RESOLVER_COMPARISON.md
CONSULT_EVIDENCE_RESOLVER_BEDROCK=true
# 호출마다 따로 엑사원으로 되돌리려면 false로 둔다(주지 않으면 위 값을 따른다)
# CONSULT_COMPARISON_EVIDENCE_BEDROCK=false
# CONSULT_CANDIDATE_EVIDENCE_BEDROCK=false
# 후보 근거 검증에서 단어 검사 대신 고객 원문, 대상 낱말 규칙, 회색 구간 판정기로 확인한다. false면 예전처럼 단어 검사로 막는다
CONSULT_CANDIDATE_EVIDENCE_JUDGE=true

# 요금제·내 정보 질문 분류를 gpt-oss(Bedrock)로 쓴다. 실패하면 엑사원으로 대체한다
CONSULT_PLAN_QUESTION_BEDROCK=false
