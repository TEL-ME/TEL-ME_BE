# 사용법: 이 파일을 복사해 .env 로 만들고 필요한 값만 바꾼다
#   cp .env.example .env
# .env 는 커밋하지 않는다

# PostgreSQL (docker-compose · application.yml 공통)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telme
POSTGRES_USER=telme
POSTGRES_PASSWORD=telme

# Ollama (Docker · Mac 앱 모두 기본 주소 동일)
OLLAMA_PORT=11434
OLLAMA_URL=http://localhost:11434
